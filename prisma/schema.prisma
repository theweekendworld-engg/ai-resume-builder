generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectSource {
  github
  manual
  pdf_resume
}

enum KnowledgeType {
  achievement
  oss_contribution
  certification
  award
  publication
  custom
}

enum GenerationStatus {
  pending
  awaiting_clarification
  generating
  completed
  failed
}

enum ResumeImportStatus {
  pending
  processing
  ready
  completed
  failed
}

enum Channel {
  web
  telegram
  whatsapp
  email
}

enum PipelineStep {
  reuse_check
  jd_parsing
  semantic_search
  static_data_load
  awaiting_clarification
  paraphrasing
  resume_assembly
  claim_validation
  ats_scoring
  pdf_generation
  completed
}

enum ResumeImportStep {
  upload_received
  pdf_text_extract
  pdf_link_extract
  ai_parse
  ready
  failed
}

// --- Career Context Graph: evidence + grounding (v2 architecture §3) ---
enum EvidenceKind {
  repo
  metric_confirmed
  document
  url
  interview_assertion
  import
}

enum GroundState {
  grounded
  needs_confirmation
  unsupported
}

// --- Monetization & entitlements (v2 architecture §7) ---
enum Tier {
  free
  always_on
  pro
  team
}

// --- Application lifecycle (v2 architecture §5) ---
// Superset enum: covers the existing extension vocabulary
// (discovered/analyzed/in_progress/applied/archived) plus the richer product
// lifecycle from the master plan so existing rows migrate cleanly and neither
// the extension nor future web UI breaks. `applied` and `submitted` overlap by
// design during the transition; dedupe is a follow-up.
enum ApplicationStatus {
  discovered
  analyzed
  drafting
  in_progress
  submitted
  applied
  in_review
  interview
  offer
  rejected
  ghosted
  archived
}

model Resume {
  id             String   @id @default(cuid())
  userId         String // Clerk User ID
  title          String   @default("My Resume")
  targetRole     String?
  targetCompany  String?
  atsScore       Int?
  atsSummary     String?
  content        Json?
  /// How this resume answers the posting it was tailored to — the requirement
  /// coverage, the gaps, and the lines that did not make the page.
  ///
  /// Lives on the Resume rather than the GenerationSession because it is a
  /// fact about THIS document against THAT job, and it has to survive the
  /// session that produced it: the editor is where a candidate acts on it.
  /// Shape: `ResumeCoverage` in `src/lib/resume/report.ts`.
  coverageReport Json?
  /// Set on a per-job copy: the resume it was tailored FROM. Refining for a
  /// job creates a copy; it never overwrites the base (audit 2026-09-27, F).
  baseResumeId   String?
  /// The tracked job (ApplicationWorkspace) this copy was tailored for.
  workspaceId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([workspaceId])
}

model JobTarget {
  id          String   @id @default(cuid())
  userId      String
  resumeId    String?
  company     String   @default("")
  role        String   @default("")
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, resumeId, updatedAt])
  @@index([userId, updatedAt])
}

model UserProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  fullName           String   @default("")
  email              String   @default("")
  phone              String   @default("")
  location           String   @default("")
  website            String   @default("")
  linkedin           String   @default("")
  github             String   @default("")
  defaultTitle       String   @default("")
  defaultSummary     String   @default("")
  yearsExperience    String   @default("")
  preferences        Json?
  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model UserProject {
  id            String        @id @default(cuid())
  userId        String
  name          String
  description   String        @default("")
  url           String        @default("")
  githubUrl     String?
  technologies  Json          @default("[]")
  readme        String        @default("")
  source        ProjectSource @default(manual)
  qdrantPointId String?
  embedded      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([userId, githubUrl])
  @@index([userId, updatedAt])
}

model UserExperience {
  id            String   @id @default(cuid())
  userId        String
  company       String
  role          String
  startDate     String
  endDate       String   @default("")
  current       Boolean  @default(false)
  location      String   @default("")
  description   String   @default("")
  highlights    Json     @default("[]")
  qdrantPointId String?
  embedded      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, updatedAt])
}

model UserEducation {
  id           String   @id @default(cuid())
  userId       String
  institution  String
  degree       String
  fieldOfStudy String   @default("")
  startDate    String
  endDate      String   @default("")
  current      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model KnowledgeItem {
  id            String        @id @default(cuid())
  userId        String
  type          KnowledgeType
  title         String
  content       String
  metadata      Json?
  qdrantPointId String?
  embedded      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId, type])
}

model GenerationSession {
  id                  String           @id @default(cuid())
  userId              String
  sourceResumeId      String?
  jobTargetId         String?
  /// The tracked job this generation is for, when started from Scout / the tracker.
  workspaceId         String?
  jobDescription      String
  channel             Channel          @default(web)
  currentStep         PipelineStep     @default(reuse_check)
  parsedJD            Json?
  matchedItems        Json?
  matchedProjects     Json?
  matchedAchievements Json?
  staticData          Json?
  fallbackResume      Json?
  paraphrasedContent  Json?
  draftResume         Json?
  validationResult    Json?
  atsScore            Int?
  pdfBlobKey          String?
  pdfUrl              String?
  clarifications      Json?
  status              GenerationStatus @default(pending)
  resultResumeId      String?
  errorMessage        String?
  errorStep           PipelineStep?
  workflowRunId       String?
  stepStartedAt       DateTime?
  lastNotifiedState   String?
  retryCount          Int              @default(0)
  startedAt           DateTime         @default(now())
  completedAt         DateTime?
  totalLatencyMs      Int?
  totalTokensUsed     Int?
  totalCostUsd        Float?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
  @@index([status])
}

model ResumeImportSession {
  id            String             @id @default(cuid())
  userId        String
  status        ResumeImportStatus @default(pending)
  currentStep   ResumeImportStep   @default(upload_received)
  workflowRunId String?
  blobKey       String
  blobUrl       String
  fileName      String
  parsedData    Json?
  errorMessage  String?
  stepStartedAt DateTime?
  startedAt     DateTime           @default(now())
  completedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
}

model TelegramUpdateReceipt {
  id        String   @id @default(cuid())
  updateId  String   @unique
  createdAt DateTime @default(now())
}

model GeneratedPdf {
  id            String    @id @default(cuid())
  userId        String
  resumeId      String
  sessionId     String?
  blobKey       String
  blobUrl       String
  fileSizeBytes Int
  template      String    @default("ats-simple")
  createdAt     DateTime  @default(now())
  expiresAt     DateTime?

  @@index([userId, createdAt])
  @@index([resumeId])
  @@index([sessionId])
}

model ChannelIdentity {
  id         String   @id @default(cuid())
  userId     String
  channel    Channel
  externalId String
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([channel, externalId])
  @@index([userId])
}

model ChannelLinkToken {
  id         String    @id @default(cuid())
  userId     String
  channel    Channel
  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, channel, createdAt])
  @@index([channel, token])
}

model ApiUsageLog {
  id           String   @id @default(cuid())
  userId       String
  sessionId    String?
  operation    String
  provider     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  costUsd      Float    @default(0)
  latencyMs    Int      @default(0)
  status       String   @default("success")
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([createdAt])
}

model UserUsageSummary {
  id               String   @id @default(cuid())
  userId           String
  periodStart      DateTime
  periodEnd        DateTime
  totalTokens      Int      @default(0)
  totalCostUsd     Float    @default(0)
  totalGenerations Int      @default(0)
  totalPdfs        Int      @default(0)
  breakdown        Json?
  createdAt        DateTime @default(now())

  @@unique([userId, periodStart])
  @@index([userId])
}

model ParsedJDCache {
  id        String   @id @default(cuid())
  jdHash    String   @unique
  parsedJD  Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([jdHash])
  @@index([expiresAt])
}

model ApplicationWorkspace {
  id                        String                @id @default(cuid())
  userId                    String
  sourcePlatform            String?
  sourceUrl                 String
  companyName               String?
  roleTitle                 String?
  location                  String?
  employmentType            String?
  compensationText          String?
  jobDescription            String?
  applicationStatus         ApplicationStatus     @default(discovered)
  fitScore                  Int?
  fitSummary                String?
  /// Scout's verdict: strong | possible | stretch | not_a_fit | unknown.
  fitVerdict                String?
  /// The Scout run that analysed this job, when it came in through Scout.
  scoutRunId                String?               @unique
  companySnapshot           Json?
  linkedJobTargetId         String?
  latestGenerationSessionId String?
  selectedResumeId          String?
  selectedGeneratedPdfId    String?
  lastViewedAt              DateTime?
  // Multi-step orchestration (Phase 1 slice 3): mirrors the per-tab session
  // held in the extension's background worker, so the user can leave / come
  // back and pick up where they left off.
  activeSessionId           String?
  sessionState              Json?
  currentStepIndex          Int?
  totalSteps                Int?
  currentStepLabel          String?
  stepHistory               Json                  @default("[]")
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  questions                 ApplicationQuestion[]

  @@unique([userId, sourceUrl])
  @@index([userId, updatedAt])
  @@index([userId, companyName, roleTitle, updatedAt])
}

model ApplicationQuestion {
  id           String                @id @default(cuid())
  userId       String
  workspaceId  String?
  sourceUrl    String?
  platform     String?
  companyName  String?
  roleTitle    String?
  questionText String
  questionType String
  answerMode   String?
  helperText   Json?
  draftAnswers Json?
  sourceFacts  Json?
  warnings     Json?
  finalAnswer  String?
  selectedTone String?
  confidence   Float?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  workspace    ApplicationWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([userId, sourceUrl, updatedAt])
  @@index([workspaceId, updatedAt])
}

model ReusableAnswer {
  id                  String    @id @default(cuid())
  userId              String
  questionFingerprint String
  canonicalQuestion   String
  questionType        String?
  answerMode          String?
  answerText          String
  usageCount          Int       @default(0)
  autoUse             Boolean   @default(false)
  sourceQuestionId    String?
  metadata            Json?
  lastUsedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([userId, questionFingerprint])
  @@index([userId, updatedAt])
  @@index([userId, autoUse, updatedAt])
}

model CompanyInsight {
  id                    String   @id @default(cuid())
  normalizedCompanyName String
  website               String?
  employeeCount         Int?
  fundingTotal          String?
  revenueEstimateText   String?
  reviewSummary         String?
  engineeringSummary    String?
  alumniSignalSummary   String?
  confidence            Float    @default(0)
  freshnessLabel        String?
  rawData               Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([normalizedCompanyName, website])
  @@index([normalizedCompanyName, updatedAt])
  @@index([updatedAt])
}

model ExtensionAccessToken {
  id         String    @id @default(cuid())
  userId     String
  client     String    @default("chrome_extension")
  tokenHash  String    @unique
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, client, revokedAt, expiresAt])
  @@index([expiresAt])
}

model ExtensionConnectGrant {
  id             String    @id @default(cuid())
  client         String    @default("chrome_extension")
  verifierHash   String    @unique
  approvedUserId String?
  approvedAt     DateTime?
  consumedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([expiresAt])
  @@index([approvedUserId, createdAt])
}

model FunnelEvent {
  id         String   @id @default(cuid())
  sessionId  String
  userId     String?
  type       String
  payload    Json     @default("{}")
  ipHash     String?
  occurredAt DateTime @default(now())

  @@index([type, occurredAt])
  @@index([sessionId])
  @@index([userId, occurredAt])
}

model ExtensionEvent {
  id         String   @id @default(cuid())
  userId     String
  type       String
  payload    Json     @default("{}")
  extVersion String?
  occurredAt DateTime @default(now())

  @@index([userId, occurredAt])
  @@index([type, occurredAt])
}

// =========================================================================
// Career Context Graph — evidence & impact layer (v2 architecture §3)
// The truth substrate the Truthfulness Engine and Context Interview share.
// =========================================================================

model Evidence {
  id              String       @id @default(cuid())
  userId          String
  kind            EvidenceKind
  sourceRef       String // github repo id, blob key, URL, ResumeImportSession id, ...
  excerpt         String // the supporting text/snippet
  confidence      Float        @default(1.0)
  confirmedByUser Boolean      @default(false)
  createdAt       DateTime     @default(now())
  claimLinks      ClaimLink[]

  @@index([userId, kind])
}

model ClaimLink {
  id          String      @id @default(cuid())
  userId      String
  claimType   String // experience_highlight | project_bullet | impact_metric | skill
  claimRefId  String // points at UserExperience/UserProject/ImpactMetric/Resume claim
  evidenceId  String
  groundState GroundState @default(needs_confirmation)
  createdAt   DateTime    @default(now())
  evidence    Evidence    @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([userId, claimType, claimRefId])
  @@index([evidenceId])
}

model ImpactMetric {
  id            String   @id @default(cuid())
  userId        String
  subjectType   String // experience | project
  subjectId     String
  statement     String // "cut p95 latency"
  metric        String // "p95 latency"
  baseline      String? // "800ms"
  result        String? // "180ms"
  delta         String? // "-77%"
  timeframe     String? // "Q2 2025, 6 weeks"
  scope         String? // "checkout service, 2M req/day"
  source        String // interview | import | github | manual
  embedded      Boolean  @default(false)
  qdrantPointId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, subjectType, subjectId])
}

// =========================================================================
// Monetization & entitlements (v2 architecture §7)
// =========================================================================

/// Career and Search are two Stripe subscriptions and therefore two rows.
///
/// This used to be keyed by writing `${userId}::search` into `userId`, because
/// the column was unique. That kept working right up until it did not: the
/// convention was supposed to live behind helpers in `entitlements.ts`, and a
/// second implementation of it had already appeared in the proactive-downgrade
/// handler as `userId.split('::')[0]`. A column whose values are sometimes not
/// what the column is named is a bug waiting for the next reader — an account
/// deletion or a data export that filters `userId = $1` silently misses the
/// Search row.
enum SubscriptionSlot {
  career
  search
}

model Subscription {
  id               String           @id @default(cuid())
  userId           String
  slot             SubscriptionSlot @default(career)
  stripeCustomerId String
  stripeSubId      String?
  tier             Tier             @default(free)
  status           String // active | past_due | canceled | trialing | incomplete
  currentPeriodEnd DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  /// One row per slot per user. Replaces the `userId @unique` that forced the
  /// `::search` suffix.
  @@unique([userId, slot])
  @@index([stripeCustomerId])
}

model UsageQuota {
  id          String   @id @default(cuid())
  userId      String
  periodStart DateTime
  action      String // tailored_generation | auto_apply | context_interview | tier2_grounding
  used        Int      @default(0)
  limit       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, periodStart, action])
  @@index([userId, action])
}

// =========================================================================
// Career OS v3 — platform primitives (impl/00 ADR-1, ADR-4, ADR-7)
// Owned by the orchestrator. Feature agents must not edit this file.
// =========================================================================

enum JobStatus {
  pending
  running
  succeeded
  failed
  dead
}

/// Postgres-as-queue. Drained by the single hourly cron (ADR-2) under a time
/// budget. Handlers fan out rather than loop — see impl/00 §P-2.
model Job {
  id          String    @id @default(cuid())
  kind        String
  payload     Json      @default("{}")
  /// Unique idempotency key. A duplicate enqueue is a silent no-op, not an error.
  dedupeKey   String?   @unique
  status      JobStatus @default(pending)
  priority    Int       @default(100)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  result      Json?
  durationMs  Int?
  costUsd     Float     @default(0)
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([status, runAt, priority])
  @@index([kind, createdAt])
  @@index([status, lockedAt])
}

model EmailSend {
  id         String    @id @default(cuid())
  userId     String
  template   String
  subject    String
  providerId String?
  status     String    @default("queued") // queued|sent|delivered|bounced|complained|failed
  openedAt   DateTime?
  clickedAt  DateTime?
  error      String?
  createdAt  DateTime  @default(now())

  /// Unique so the provider webhook resolves a send exactly, rather than
  /// findFirst-by-recency. Provider ids are already unique upstream.
  @@unique([providerId])
  @@index([userId, createdAt])
  @@index([template, createdAt])
}

/// Notification preferences + the derived weekly-digest schedule (ADR-3).
/// Timezone and digest slot live here, not in UserProfile.preferences JSON, so
/// the "who is due this hour" query is indexable.
model EmailPreference {
  userId           String   @id
  weeklyDigest     Boolean  @default(true)
  monthlyReview    Boolean  @default(true)
  radarDigest      Boolean  @default(true)
  missionNudges    Boolean  @default(true)
  productUpdates   Boolean  @default(true)
  unsubscribedAll  Boolean  @default(false)
  unsubscribeToken String   @unique
  timezone         String   @default("Etc/UTC")
  digestDay        Int      @default(5) // 1=Mon … 7=Sun
  digestHour       Int      @default(16)
  digestChannel    Channel  @default(email)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([weeklyDigest, digestDay, digestHour])
}

model FeatureFlag {
  key            String   @id
  enabled        Boolean  @default(false)
  allowUserIds   Json     @default("[]")
  rolloutPercent Int      @default(0)
  description    String   @default("")
  updatedAt      DateTime @updatedAt
}

// =========================================================================
// The Work Log — the kernel (PRD 01)
// Confirming a Win writes Evidence(confirmedByUser=true) + ClaimLink(grounded).
// That single write is both the retention loop and the moat. Do not break it.
// =========================================================================

enum WinStatus {
  draft
  confirmed
  dismissed
  archived
}

enum WinCategory {
  shipped
  improved
  fixed
  led
  influenced
  grew
  learned
  saved
}

enum WinSensitivity {
  shareable
  internal_only
  confidential
}

enum WinSource {
  manual
  /// Sent to the Telegram or WhatsApp bot as a note.
  chat
  github
  calendar
  linear
  jira
  ambient
  backfill
  import
}

model Win {
  id              String         @id @default(cuid())
  userId          String
  title           String // <= 120 chars, enforced in the app layer
  narrative       String         @default("")
  /// The date the work happened — never the date it was logged.
  occurredAt      DateTime
  periodEnd       DateTime? // multi-week efforts; occurredAt is the start
  category        WinCategory
  status          WinStatus      @default(draft)
  /// Enforced at the QUERY layer, never the prompt layer. See lib/graph/visibility.
  sensitivity     WinSensitivity @default(shareable)
  source          WinSource
  sourceRef       String? // PR url, calendar event id, telegram msg id
  /// One Win per capture signal. Populated in Wave C; unique prevents double-draft.
  signalId        String?        @unique
  employerId      String? // -> UserExperience.id
  projectId       String? // -> UserProject.id
  skills          Json           @default("[]")
  collaborators   Json           @default("[]")
  impactMetricId  String? // -> ImpactMetric.id
  confidence      Float          @default(0.5)
  dismissedReason String? // not_a_win | noise | duplicate | expired | user
  confirmedAt     DateTime?
  embedded        Boolean        @default(false)
  qdrantPointId   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, occurredAt(sort: Desc)])
  @@index([userId, status, createdAt])
  @@index([userId, employerId, occurredAt])
  @@index([userId, category, occurredAt])
  @@index([userId, sensitivity])
}

model WeeklyDigest {
  id             String    @id @default(cuid())
  userId         String
  /// Monday 00:00 in the user's timezone, stored UTC.
  weekStart      DateTime
  channel        Channel
  winIds         Json      @default("[]")
  /// Root of the signed single-use action tokens embedded in the email.
  token          String    @unique
  sentAt         DateTime?
  openedAt       DateTime?
  firstActionAt  DateTime?
  confirmedCount Int       @default(0)
  dismissedCount Int       @default(0)
  /// True when an empty signal week intentionally produced no send.
  skipped        Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@unique([userId, weekStart])
  @@index([userId, sentAt])
}

// =========================================================================
// Wave C — capture connectors (PRD 02 §5)
// Orchestrator-owned. Landed ahead of Wave C so no feature agent edits this file.
// =========================================================================

enum CaptureSourceKind {
  github
  calendar
  linear
  jira
}

enum CaptureSourceStatus {
  active
  paused
  error
  revoked
}

enum CaptureRunStatus {
  running
  success
  degraded
  failed
}

model CaptureSource {
  id                 String              @id @default(cuid())
  userId             String
  kind               CaptureSourceKind
  status             CaptureSourceStatus @default(active)
  externalAccountId  String // gh login/id, google sub, ...
  scopes             Json                @default("[]")
  /// includedRepos[], excludedKeywords[], calendars[] — adapter-specific.
  config             Json                @default("{}")
  /// ISO timestamp of the last processed item. Deliberately not a page token:
  /// timestamps survive provider API changes, page tokens do not.
  cursor             String?
  consentGrantedAt   DateTime
  /// Which consent copy the user agreed to. We must be able to answer
  /// "what exactly did this user consent to, and when".
  consentCopyVersion String
  lastSyncedAt       DateTime?
  lastSuccessAt      DateTime?
  errorCount         Int                 @default(0)
  lastError          String?
  revokedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  runs    CaptureRun[]
  signals CaptureSignal[]

  /// One source per kind per user in R1. Relaxing this to include
  /// externalAccountId is what enables two GitHub accounts (PRD 02 §11).
  @@unique([userId, kind])
  @@index([status, lastSyncedAt])
}

model CaptureSignal {
  id          String    @id @default(cuid())
  userId      String
  sourceId    String
  /// Provider-stable id — GitHub node ID, never the PR number, which is
  /// per-repo and reused after transfers.
  externalId  String
  kind        String // pr_merged | pr_reviewed | issue_closed | release_published | repo_created
  occurredAt  DateTime
  title       String
  body        String    @default("")
  url         String?
  metadata    Json      @default("{}")
  /// Set when several signals collapse into one candidate (PRD 02 §4.1).
  groupKey    String?
  isNoise     Boolean   @default(false)
  noiseRule   String?
  processedAt DateTime?
  winId       String?
  createdAt   DateTime  @default(now())

  source CaptureSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  /// THE idempotency guarantee. Makes re-syncing safe, makes a duplicated
  /// cron harmless, and guarantees one Win per signal. Do not drop this.
  @@unique([sourceId, externalId])
  @@index([userId, occurredAt])
  @@index([sourceId, processedAt])
  @@index([groupKey])
}

model CaptureRun {
  id           String           @id @default(cuid())
  userId       String
  sourceId     String
  status       CaptureRunStatus @default(running)
  trigger      String // initial | scheduled | manual
  windowStart  DateTime?
  windowEnd    DateTime?
  itemsScanned Int              @default(0)
  itemsNoise   Int              @default(0)
  candidates   Int              @default(0)
  winsDrafted  Int              @default(0)
  costUsd      Float            @default(0)
  error        String?
  startedAt    DateTime         @default(now())
  finishedAt   DateTime?

  source CaptureSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([sourceId, startedAt])
}

// =========================================================================
// Wave C — review packets & competency frameworks (PRD 03 §6)
// =========================================================================

enum FrameworkSource {
  uploaded
  template
  default
}

enum PacketType {
  performance_review
  promotion_case
  self_appraisal
  brag_doc
}

enum PacketStatus {
  generating
  ready
  failed
}

model CompetencyFramework {
  id             String          @id @default(cuid())
  /// Null for system-owned public templates (Google, Meta, ... ).
  userId         String?
  name           String
  sourceType     FrameworkSource
  companyName    String?
  /// [{key,name,order,summary}]
  levels         Json            @default("[]")
  /// [{key,name,description,levelExpectations:{levelKey:string}}]
  competencies   Json            @default("[]")
  rawSourceRef   String? // blob key of the uploaded document
  /// An internal leveling rubric is confidential by default: user-scoped,
  /// never shared across users, never training data.
  isConfidential Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
  @@index([sourceType, companyName])
}

model ReviewPacket {
  id           String       @id @default(cuid())
  userId       String
  type         PacketType
  status       PacketStatus @default(generating)
  periodStart  DateTime
  periodEnd    DateTime
  employerId   String?
  frameworkId  String?
  targetLevel  String?
  audience     String       @default("manager")
  /// Exact inputs, so a packet is reproducible.
  winIds       Json         @default("[]")
  /// {summary, themes[], competencies[], growth, appendix}
  content      Json?
  /// Block-keyed overrides that survive regeneration.
  userEdits    Json         @default("{}")
  gaps         Json         @default("[]")
  wordCount    Int          @default(0)
  exports      Json         @default("[]")
  generationMs Int?
  costUsd      Float        @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId, createdAt])
  @@index([userId, periodEnd])
}

// =========================================================================
// Wave C — backfill interview (PRD 07 §5.2)
// =========================================================================

enum InterviewStatus {
  active
  paused
  completed
  abandoned
}

enum InterviewSubject {
  employer
  project
  competency
  period
}

model InterviewSession {
  id            String           @id @default(cuid())
  userId        String
  subjectType   InterviewSubject
  subjectId     String?
  subjectLabel  String
  status        InterviewStatus  @default(active)
  /// [{role, content, at}] — sensitive PII. People disclose conflicts and
  /// failures here. Never embedded for external output; deletable
  /// independently of the Wins it produced.
  transcript    Json             @default("[]")
  /// Prevents repeating a topic across a resumed session.
  askedTopics   Json             @default("[]")
  winIds        Json             @default("[]")
  questionCount Int              @default(0)
  costUsd       Float            @default(0)
  startedAt     DateTime         @default(now())
  lastActiveAt  DateTime         @updatedAt
  completedAt   DateTime?
  expiresAt     DateTime

  @@index([userId, status, lastActiveAt])
  @@index([expiresAt])
}

// =========================================================================
// Month in Review (PRD 01 §6.4)
//
// The only scheduled payoff before the first review packet at ~month six, so
// it carries the first quarter of the relationship on its own.
//
// Stored rather than composed on demand: recomposing per page load would give
// a different document on every refresh, which is fatal for the artefact
// people screenshot. Previously lived in `Job.result`, which is durable but
// not queryable and gets pruned by any job retention policy.
// =========================================================================

model MonthlyReview {
  id              String    @id @default(cuid())
  userId          String
  /// `yyyy-mm` of the month being reviewed, in the user's timezone.
  period          String
  headline        String
  /// The one generated block. Null when composition was dropped by the
  /// entity or digit check — fail closed; every other block is computed.
  paragraph       String?
  /// Deterministic, from real counts. Null when no rule fired; the spec
  /// forbids falling back to generic encouragement.
  observation     String?
  mixSentence     String?
  receipt         String
  winIds          Json      @default("[]")
  winCount        Int       @default(0)
  quantifiedCount Int       @default(0)
  /// Null until the email actually goes out. The web view renders either way.
  sentAt          DateTime?
  degraded        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, period])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────── Career Radar
//
// PRD 04. The one rule that shapes every model here: a language model may
// never produce a compensation number. Bands are arithmetic over ranges we
// read verbatim out of public postings, so the raw evidence has to be stored,
// attributable, and re-checkable — hence `sourceUrl` and `rawRange` on every
// posting rather than just a computed band.

enum JobBoardProvider {
  greenhouse
  lever
  ashby
}

enum JobSourceStatus {
  active
  /// Five consecutive 404s (PRD 04 §3.1). Kept, not deleted — boards come back.
  inactive
  /// Repeated 429/5xx. Distinct from `inactive` so we can retry sooner.
  throttled
}

/// A public job board we are allowed to poll. Discovery, not fetching, is the
/// real work (§3.1): seeded from CompanyInsight/ApplicationWorkspace, a curated
/// launch list, and — the compounding one — extension sightings.
model JobSource {
  id          String           @id @default(cuid())
  provider    JobBoardProvider
  /// Board identifier in the provider's namespace: the `stripe` in
  /// boards-api.greenhouse.io/v1/boards/stripe/jobs.
  boardToken  String
  companyName String
  status      JobSourceStatus  @default(active)

  /// How this board entered the system, for coverage analysis.
  discoveredVia      String  @default("seed")
  /// Set when a user's extension found it, so we can measure that channel.
  discoveredByUserId String?

  /// Conditional-request cache. Sending these is the politeness contract as
  /// much as the rate limit is.
  etag         String?
  lastModified String?

  lastFetchedAt  DateTime?
  lastSuccessAt  DateTime?
  /// Consecutive 404s; at 5 the board flips to `inactive`.
  notFoundStreak Int       @default(0)
  errorCount     Int       @default(0)
  lastError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postings JobPosting[]

  /// One row per board per provider. Re-registering a known board is a no-op,
  /// which is what makes extension-driven discovery safe to fire repeatedly.
  @@unique([provider, boardToken])
  @@index([status, lastFetchedAt])
}

/// One posting, with its compensation range stored exactly as disclosed.
model JobPosting {
  id         String @id @default(cuid())
  sourceId   String
  /// The provider's own id, so re-fetching updates rather than duplicates.
  externalId String

  title       String
  /// Raw location string; normalisation lives in `geoBucket`.
  location    String?
  /// Coarse bucket the band is keyed on. Postings carry their own zoning
  /// ("Zone 1 pay range", "Local pay range"), which we keep rather than
  /// re-derive.
  geoBucket   String?
  department  String?
  absoluteUrl String
  /// Kept so an extraction bug can be re-run over history without re-fetching.
  contentHash String

  postedAt        DateTime?
  updatedAtSource DateTime?
  /// Null while live; set when the posting leaves the board.
  closedAt        DateTime?

  // ── compensation, exactly as disclosed ──
  /// Null when the posting disclosed nothing, which is the common case.
  compLow          Int?
  compHigh         Int?
  /// ISO-4217. Never converted — a stale FX rate silently corrupts every
  /// band built on it (§3.1).
  compCurrency     String?
  compPeriod       String?
  /// Period-normalised for comparison; the original stays in compLow/High.
  compAnnualLow    Int?
  compAnnualHigh   Int?
  /// `structured` (the board tagged it) or `prose` (we matched it).
  compSource       String?
  /// The posting's own label, e.g. "Zone 1 pay range".
  compLabel        String?
  /// False when disclosed but unfit to pool: degenerate, implausibly wide,
  /// unknown currency. Stored rather than dropped, because "disclosed but
  /// unusable" is a real coverage metric.
  compBandEligible Boolean @default(false)
  compRejectReason String?

  /// Normalised skill slugs from the requirements, for SkillSignal rollup.
  skills Json @default("[]")

  /// Role classification, computed once at ingest so a band query is an index
  /// scan rather than a re-classification of every row on every read.
  roleFamily String?
  seniority  String?
  /// `family::seniority::geo`. NULL when the posting must never enter a
  /// published band — an unclassifiable title, or an intern posting. Storing
  /// the exclusion as a NULL rather than leaving it to a runtime check means a
  /// future caller writing its own query cannot forget it.
  bandKey    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, externalId])
  /// The band query: eligible rows for a geo, recent first.
  @@index([bandKey, compBandEligible, postedAt])
  @@index([sourceId, closedAt])
}

/// Nightly rollup over the last 90/365 days (§3.2). Trend is only rendered
/// above `postingCount >= 50` in both windows — below that it is noise, and
/// charting noise is lying with a chart.
model SkillSignal {
  id        String @id @default(cuid())
  /// Curated alias map output: postgres/postgresql/psql -> postgresql.
  skillNorm String
  /// `90d` or `365d`.
  window    String
  geoBucket String

  postingCount Int
  /// Median of disclosed ranges requiring this skill, in `currency`.
  medianLow    Int?
  medianHigh   Int?
  currency     String?
  /// Percent change vs. the previous equivalent window. Null when either
  /// window is under the display threshold.
  trendPercent Float?
  /// Distribution across seniority, as { junior: n, mid: n, senior: n, ... }.
  seniorityMix Json    @default("{}")

  computedAt DateTime @default(now())

  @@unique([skillNorm, window, geoBucket])
  @@index([geoBucket, postingCount])
}

/// A real offer a user chose to share (§3.3) — the slow-compounding asset no
/// competitor can copy. Aggregate-only in output, minimum n=8 before it moves
/// a band, and never displayable in a way that identifies company+level+person.
model OfferDataPoint {
  id     String @id @default(cuid())
  /// Retained for deletion requests and dedupe. Never emitted in output.
  userId String

  roleTitle   String
  level       String?
  geoBucket   String
  companyName String?

  baseAmount       Int
  currency         String
  /// Captured separately and never folded into base (§3.1).
  equityAnnualized Int?
  bonusAmount      Int?

  offeredAt DateTime
  createdAt DateTime @default(now())

  /// One shared offer per workspace, so re-answering edits rather than
  /// double-counts.
  workspaceId String? @unique

  @@index([roleTitle, geoBucket, offeredAt])
  @@index([userId])
}

// ═══════════════════════════════════════════════════ Missions (PRD 05)
//
// A Mission is a goal the user commits to, decomposed into steps that consume
// and enrich the graph, with a completion condition and a recorded outcome.
//
// Templates live in code (`src/lib/missions/catalog.ts`), never here.
// Instantiating a mission COPIES the template into MissionStep rows, so
// shipping a changed template can never mutate someone's in-flight mission.

enum MissionType {
  get_promoted
  land_new_role
  switch_domain
  negotiate_offer
  ic_to_manager
  return_from_break
  keep_warm
}

enum MissionStatus {
  proposed
  active
  paused
  completed
  abandoned
}

enum MissionStepStatus {
  pending
  active
  done
  skipped
  blocked
}

enum MissionStepKind {
  automatic
  threshold
  attested
}

model Mission {
  id     String        @id @default(cuid())
  userId String
  type   MissionType
  status MissionStatus @default(proposed)

  /// User-editable — "Staff by March", not the catalog's generic label.
  title      String
  targetDate DateTime?

  /// targetLevel, frameworkId, weeklyApplicationTarget, … — per-type config
  /// the catalog reads when instantiating and the evaluator reads when
  /// scoring thresholds.
  config Json @default("{}")

  startedAt   DateTime?
  pausedAt    DateTime?
  completedAt DateTime?

  /// {result, reportedAt, note, compDelta?} — §2 rule 4: completion ALWAYS
  /// asks "did you get it?". This column is the outcome dataset.
  outcome Json?

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  steps     MissionStep[]

  @@index([userId, status, updatedAt])
}

model MissionStep {
  id        String @id @default(cuid())
  missionId String

  /// Stable identifier from the template, e.g. 'close_gap'. Survives a title
  /// change, which is why progress keys off it and not the label.
  key   String
  title String
  order Int

  kind   MissionStepKind
  status MissionStepStatus @default(pending)

  /// {event} for automatic, {query, threshold} for threshold, {} for attested.
  condition Json @default("{}")

  /// {current, target} — DERIVED. §6.1: never incremented by an event handler,
  /// always recomputed by `evaluateMission`. Stored only so the UI can render
  /// without re-running the evaluator.
  progress Json @default("{}")

  dueAt         DateTime?
  completedAt   DateTime?
  blockedReason String?

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([missionId, key])
  @@index([missionId, order])
}

// ─────────────────────────────────────────────────────────────── agent runs
// docs/impl/06-scout-agent.md. A domain-agnostic run/step ledger: the user's
// timeline and the operator's trace are the same rows.

enum AgentRunStatus {
  queued
  running
  /// Paused on a question only the user can answer. `pendingQuestion` holds it.
  awaiting_input
  succeeded
  /// Finished, but at least one section was unavailable. Not a failure.
  partial
  failed
}

enum AgentStepStatus {
  running
  succeeded
  /// The step ran and had nothing to say (no key configured, no data). Carries a reason.
  unavailable
  skipped
  failed
}

model AgentRun {
  id     String @id @default(cuid())
  userId String
  /// 'scout'. A string, not an enum: the harness is shared by future agents.
  agent  String

  /// Dedupe key for the input (normalized URL or text hash). The same link
  /// shared twice returns the same run; refresh is explicit.
  inputKey String
  /// {url?, text?, source}
  input    Json
  /// Classified kind, null until classification runs.
  kind     String?
  status   AgentRunStatus @default(queued)
  channel  Channel        @default(web)
  /// Channel-specific handle for edit-in-place progress, e.g. {chatId, messageId}.
  channelRef Json?

  workflowRunId   String?
  /// {id, prompt, options?, field} while status = awaiting_input.
  pendingQuestion Json?
  /// Answers the user has given this run, keyed by question id.
  answers         Json @default("{}")
  /// Section name → SectionResult. Written as each section finishes.
  result          Json @default("{}")

  costUsd   Float   @default(0)
  stepCount Int     @default(0)
  error     String?

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  steps AgentStep[]

  @@unique([userId, inputKey])
  @@index([userId, createdAt])
  @@index([agent, status, createdAt])
}

model AgentStep {
  id      String          @id @default(cuid())
  runId   String
  name    String
  status  AgentStepStatus @default(running)
  attempt Int             @default(1)

  /// Short human reason for unavailable / skipped / failed. Shown to the user.
  reason    String?
  /// [{url, title, fetchedAt}] — every external source this step read.
  sources   Json    @default("[]")
  output    Json?
  error     String?
  costUsd   Float   @default(0)
  latencyMs Int?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, name, attempt])
  @@index([name, status, startedAt])
}

/// Public research shared across users: company facts, comp figures,
/// interview links. Never holds anything user-specific.
model ResearchCache {
  id        String   @id @default(cuid())
  key       String   @unique
  kind      String
  payload   Json
  sources   Json     @default("[]")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, expiresAt])
}

/// A knowledge post the user saved. Deliberately NOT KnowledgeItem, which
/// feeds resumes: someone else's post is not the user's evidence.
model SavedInsight {
  id        String   @id @default(cuid())
  userId    String
  runId     String?  @unique
  url       String?
  author    String?
  title     String
  takeaways Json     @default("[]")
  tags      Json     @default("[]")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum ContactSource {
  linkedin_export
  extension
  manual
}

/// A first-degree connection, from the user's own LinkedIn data export.
model Contact {
  id                String        @id @default(cuid())
  userId            String
  fullName          String
  profileUrl        String?
  email             String?
  company           String?
  normalizedCompany String?
  position          String?
  connectedOn       DateTime?
  source            ContactSource @default(linkedin_export)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([userId, profileUrl])
  @@index([userId, normalizedCompany])
}

/// Inbound-message dedupe for channels other than Telegram (which predates
/// this and keeps `TelegramUpdateReceipt`). Webhook providers redeliver; a
/// redelivered "analyse this link" must not start, or charge for, a second run.
model ChannelMessageReceipt {
  id         String   @id @default(cuid())
  channel    Channel
  externalId String
  createdAt  DateTime @default(now())

  @@unique([channel, externalId])
  @@index([createdAt])
}

/// The free /score result, held server-side so it survives sign-up (email
/// verification in a new tab lost the sessionStorage copy, and /welcome
/// cleared it before the editor could apply the fixes: audit 2026-09-27, B).
model PendingScore {
  id        String    @id @default(cuid())
  /// Set when a signed-in user claims it.
  userId    String?
  payload   Json
  claimedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

/// The vector store, in Postgres (pgvector). Replaced Qdrant Cloud on
/// 2026-09-27, when the free cluster was suspended for inactivity and every
/// semantic search in production failed with "fetch failed": one database is
/// one thing that can be down, not two. Accessed only through raw SQL in
/// `src/lib/pgVectorClient.ts`, which presents the Qdrant client surface the
/// app already uses. `size` guards against an embedding-model change mixing
/// dimensions in one collection.
model VectorCollection {
  name      String   @id
  size      Int
  distance  String
  createdAt DateTime @default(now())
}

/// One embedded point. `userId`, `type` and `sourceId` are copied out of the
/// payload so the filters every search uses are plain indexed columns.
/// Search is an exact scan inside one user's points (a few hundred at most),
/// so there is no ANN index: exact is both correct and fast at that size.
model VectorPoint {
  collection String
  id         String
  userId     String?
  type       String?
  sourceId   String?
  payload    Json
  embedding  Unsupported("vector")
  updatedAt  DateTime                 @default(now()) @updatedAt

  @@id([collection, id])
  @@index([collection, userId, type])
  @@index([collection, type])
}
