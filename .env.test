# Test environment — local Docker only. No secrets, safe to commit.
#
# WHY THIS FILE EXISTS
# `bun test` sets NODE_ENV=test, and Bun deliberately does NOT load `.env.local`
# in that mode. Without this file tests fall through to `.env`, which points at
# the production Supabase — so integration tests would either hit prod or hang
# against a paused project. Bun loads `.env.{NODE_ENV}` at higher priority than
# `.env`, so this pins tests to the local containers.
#
# Requires: docker containers `ai-resume-builder-postgres` and
# `ai-resume-builder-qdrant` running (see docker-compose).

DATABASE_URL=postgres://postgres:postgres@localhost:5432/resume_builder
DIRECT_URL=postgres://postgres:postgres@localhost:5432/resume_builder

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Guard rails: entitlement enforcement off so quota gates never fail a test for
# the wrong reason; assert on the returned decision instead.
ENTITLEMENTS_ENFORCE=false

# Never used by tests — every model call is mocked. Present so config resolution
# does not throw on a missing key.
OPENAI_API_KEY=sk-test-not-a-real-key

# Deliberately fake. `sendEmail` checks emailConfigured() BEFORE it checks user
# preferences, so without these the opt-out and critical-bypass paths are
# unreachable and would never be tested. Anything that gets past the preference
# gate and actually calls Resend will fail — those cases stay TODO(provider).
RESEND_API_KEY=re_test_not_a_real_key
EMAIL_FROM=Patronus Test <test@mail.example.com>
CRON_SECRET=test-cron-secret
WIN_MAGIC_LINK_SECRET=test-magic-link-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
