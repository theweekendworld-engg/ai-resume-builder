# Patronus — environment reference
#
# Copy to `.env` and fill in. Notes on file precedence, because it has already
# caused one near-miss:
#   - Next.js dev loads .env.local over .env
#   - `bun test` sets NODE_ENV=test and DELIBERATELY SKIPS .env.local, loading
#     .env.test over .env instead. Without .env.test (committed, local-only),
#     the test suite runs against whatever .env points at — production.
#   - The Prisma CLI reads .env only. When working against local Docker while
#     .env points at a hosted database, override inline:
#       DATABASE_URL=... DIRECT_URL=... bunx prisma migrate deploy

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# App connection. Use the pooler on serverless.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/resume_builder
# Direct connection for `prisma migrate` only — the pooler breaks prepared
# statements. On Supabase these differ; locally they are the same.
DIRECT_URL=postgres://postgres:postgres@localhost:5432/resume_builder

# ---------------------------------------------------------------------------
# Vector store
# ---------------------------------------------------------------------------
# Default: vectors live in the Postgres above (pgvector). Nothing to set; the
# extension and tables are created on first use. Locally, docker-compose runs
# the pgvector/pgvector image. Set VECTOR_STORE=qdrant only to use a Qdrant
# server instead, and then QDRANT_URL is required.
VECTOR_STORE=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# The collection is named for the embedding dimension (knowledge_base_1536), so
# changing OPENAI_EMBEDDING_MODEL starts a fresh collection and the daily
# reconcile sweep re-embeds into it. See impl/00 ADR-5.

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
# Sends chat AND embeddings when no gateway key is set below. Even with a
# gateway, this stays required — embeddings always go to OpenAI.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Routing chat somewhere cheaper (optional) ------------------------------
# Set OPENROUTER_API_KEY and chat moves to OpenRouter; OPENAI_API_KEY above is
# left alone and keeps serving embeddings. Nothing to un-set to switch back.
# Then point the per-task vars below at a gateway model id, e.g.
#   OPENAI_MODEL=z-ai/glm-5.2                 (~$0.004 per resume)
#   OPENAI_MODEL=deepseek/deepseek-v4-flash-0731
# Measured baseline for comparison: gpt-5.6-luna is ~$0.019, gpt-5 was ~$0.154.
#
# Do NOT use ':free' model ids. Those endpoints train on the prompts, and the
# landing page promises "Never sold, never used to train anything".
OPENROUTER_API_KEY=
# Override only for a proxy; defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=
# Optional attribution shown on OpenRouter's public leaderboards.
OPENAI_GATEWAY_APP_URL=
OPENAI_GATEWAY_APP_TITLE=
# Generic escape hatch for any other OpenAI-compatible endpoint (vLLM, Groq,
# Together). Ignored when OPENROUTER_API_KEY is set.
OPENAI_BASE_URL=
# Only if embeddings should bill to a different OpenAI account than the key
# above. Embeddings are never routable — no gateway serves text-embedding-3-*,
# and the vector size is baked into the Qdrant collection.
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=
# Per-task model overrides. NEVER hardcode a model id at a call site; every
# call resolves through the map in src/lib/config.ts (CLAUDE.md rule 1).
# Leave unset to inherit the general/mini defaults.
OPENAI_MODEL_GENERAL=
OPENAI_MODEL=
OPENAI_MODEL_WIN_DRAFT=
OPENAI_MODEL_WIN_STRUCTURE=
OPENAI_MODEL_DIGEST_COMPOSE=
OPENAI_MODEL_MONTH_REVIEW=
OPENAI_MODEL_PACKET_THEMES=
OPENAI_MODEL_PACKET_MAP=
OPENAI_MODEL_PACKET_COMPOSE=
OPENAI_MODEL_INTERVIEW_TURN=
OPENAI_MODEL_INTERVIEW_EXTRACT=
OPENAI_MODEL_RADAR_NORMALIZE=
OPENAI_MODEL_RADAR_REASON=

# ---------------------------------------------------------------------------
# Auth (Clerk)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated Clerk user ids with access to /admin.
ADMIN_USER_IDS=

# ---------------------------------------------------------------------------
# Background jobs (impl/00 ADR-1, ADR-2)
# ---------------------------------------------------------------------------
# Required. The cron endpoint FAILS CLOSED when unset — an open tick endpoint
# is a queue-DoS surface.
CRON_SECRET=
JOB_BATCH_SIZE=25
# Must sit under the platform function timeout: 45000 on Vercel Hobby (60s cap),
# up to 240000 on Pro (300s).
CRON_TIME_BUDGET_MS=45000
# Required in production. Without it the self-retrigger falls back to a
# deployment-specific origin and the drain chain silently does not fire.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email (impl/00 ADR-4)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Must be on the verified SENDING SUBDOMAIN, never the root domain.
EMAIL_FROM=Patronus <hello@mail.example.com>
EMAIL_REPLY_TO=
# Required, or /api/email/webhook returns 503 and accepts nothing — an
# unverified webhook could suppress any user whose provider id is guessable.
RESEND_WEBHOOK_SECRET=
EMAIL_UNSUBSCRIBE_MAILTO=

# ---------------------------------------------------------------------------
# Signed action tokens
# ---------------------------------------------------------------------------
# Signs the one-tap confirm links in the weekly digest. Single-use, 30-day
# expiry, scoped to one (win, action) pair.
WIN_MAGIC_LINK_SECRET=

# ---------------------------------------------------------------------------
# Billing (Stripe)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Display names live in src/lib/plans.ts; Tier.always_on renders as "Career"
# and Tier.pro as "Search" (CLAUDE.md rule 4).
STRIPE_PRICE_CAREER_ANNUAL=
STRIPE_PRICE_CAREER_MONTHLY=
STRIPE_PRICE_SEARCH_MONTHLY=

# ---------------------------------------------------------------------------
# Entitlements
# ---------------------------------------------------------------------------
# Defaults to enforcing in production only. Keep false until the monetization
# launch so real usage accrues before anyone is turned away.
ENTITLEMENTS_ENFORCE=false

# ── What a free account gets ────────────────────────────────────────────────
#
# Free is a trial of the whole product: a few uses of every built feature, then
# it gates. Nothing here needs a deploy — set the var, restart, done.

# Free uses of each metered feature before it gates. Moves them all at once.
ENTITLEMENT_FREE_TRIAL_USES=3

# Tailored resumes on Free, TOTAL (lifetime, never refills).
ENTITLEMENT_FREE_RESUME_LIFETIME_CAP=10

# Days of full depth on the two view-only features — the whole Career Radar
# rather than the teaser, the real readiness verdict rather than the locked
# one. A window rather than a count, because a page refresh would spend a
# count. 0 disables it.
ENTITLEMENT_FREE_TRIAL_DAYS=14

# ── Overriding one feature on one plan ──────────────────────────────────────
#
# ENTITLEMENT_LIMIT_<TIER>_<ACTION>. Beats the shared numbers above.
# TIER:   FREE | ALWAYS_ON | PRO | TEAM        (ALWAYS_ON is Career, PRO is Search)
# ACTION: TAILORED_GENERATION | REVIEW_PACKET | MONTH_IN_REVIEW | RUBRIC_UPLOAD
#         | CONTEXT_INTERVIEW | WIN_DRAFT | COVER_LETTER | RADAR_REFRESH
#         | TIER2_GROUNDING | AUTO_APPLY
# `unlimited` is a valid value; 0 closes the feature on that plan.
#
#   ENTITLEMENT_LIMIT_FREE_TAILORED_GENERATION=15
#   ENTITLEMENT_LIMIT_ALWAYS_ON_REVIEW_PACKET=8
ENTITLEMENT_ALWAYS_ON_TAILORED_PER_MONTH=15

# ── Cost backstop, per plan ─────────────────────────────────────────────────
#
# Not a product limit. A user should meet their feature quota long before this;
# if they do not, the budget below is set wrong. Free is sized off the resume
# cap at roughly 30k tokens per tailored generation.
ENTITLEMENT_TOKENS_FREE=400000
ENTITLEMENT_TOKENS_ALWAYS_ON=2000000
ENTITLEMENT_TOKENS_PRO=6000000
ENTITLEMENT_COST_USD_FREE=2
ENTITLEMENT_COST_USD_ALWAYS_ON=10
ENTITLEMENT_COST_USD_PRO=30

# Legacy hard cap across ALL plans. When set, it wins over the per-plan budgets
# above wherever it is lower. Leave unset unless you want one global ceiling.
# USAGE_MAX_MONTHLY_TOKENS_PER_USER=
# USAGE_MAX_MONTHLY_COST_USD_PER_USER=

# ---------------------------------------------------------------------------
# Integrations
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Company enrichment (optional)
# ---------------------------------------------------------------------------
# Fills CompanyInsight's employeeCount / fundingTotal / revenueEstimateText from
# a licensed provider instead of regexes over the job description.
#
# The ABSENCE of this key is the off switch — there is no feature flag. Unset
# (the default, and the state of every fresh checkout and CI run) the company
# card falls back to the job-page derivation that already worked, and the
# India-hiring signal still works because it is computed from JobPosting rows we
# already own, not bought.
#
# Swapping vendors: add an adapter in src/lib/enrichment/providers/ and a branch
# in resolveEnrichmentProvider. Changing provider automatically re-tests every
# cached company, so the swap is visible rather than silently honouring TTLs the
# old vendor wrote.
PDL_API_KEY=

# ---------------------------------------------------------------------------
# Storage / rate limiting
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Scout web research (optional) — docs/impl/06-scout-agent.md
# ---------------------------------------------------------------------------
# Powers company funding/revenue facts, public comp figures, interview-experience
# links and the "who works there" signal. Every claim is quoted from a page the
# search returned and checked in code; nothing is estimated.
#
# The ABSENCE of this key is the off switch — no feature flag. Unset, those four
# sections say "Web research is off" and the rest of a Scout run is unaffected.
# Free tier: 1,000 credits/month (basic search = 1 credit, advanced = 2).
TAVILY_API_KEY=
# Budget accounting only. Defaults to the pay-as-you-go ceiling ($0.008/credit);
# set it to your plan's rate if you are on one.
TAVILY_COST_PER_CREDIT_USD=

# ---------------------------------------------------------------------------
# WhatsApp (Scout channel, optional) — Meta WhatsApp Cloud API
# ---------------------------------------------------------------------------
# Unset ACCESS_TOKEN or PHONE_NUMBER_ID is the off switch: the webhook refuses,
# nothing is sent, and the settings card says WhatsApp is not set up.
# Webhook URL to register in the Meta app: https://<domain>/api/whatsapp/webhook
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App secret — verifies X-Hub-Signature-256 on every webhook POST. Required.
WHATSAPP_APP_SECRET=
# Any string you choose; paste the same value into the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=
# The business number users message, digits only with country code (wa.me link).
WHATSAPP_PUBLIC_NUMBER=
# Defaults to v25.0.
WHATSAPP_GRAPH_VERSION=
