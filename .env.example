# Patronus — environment reference
#
# Copy to `.env` and fill in. Notes on file precedence, because it has already
# caused one near-miss:
#   - Next.js dev loads .env.local over .env
#   - `bun test` sets NODE_ENV=test and DELIBERATELY SKIPS .env.local, loading
#     .env.test over .env instead. Without .env.test (committed, local-only),
#     the test suite runs against whatever .env points at — production.
#   - The Prisma CLI reads .env only. When working against local Docker while
#     .env points at a hosted database, override inline:
#       DATABASE_URL=... DIRECT_URL=... bunx prisma migrate deploy

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# App connection. Use the pooler on serverless.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/resume_builder
# Direct connection for `prisma migrate` only — the pooler breaks prepared
# statements. On Supabase these differ; locally they are the same.
DIRECT_URL=postgres://postgres:postgres@localhost:5432/resume_builder

# ---------------------------------------------------------------------------
# Vector store
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Dimension is fixed at collection creation. Changing it requires a new
# collection plus a full re-embed — see impl/00 ADR-5.
QDRANT_COLLECTION=knowledge_base_v2
OPENAI_EMBEDDING_DIMENSIONS=1024

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Per-task model overrides. NEVER hardcode a model id at a call site; every
# call resolves through the map in src/lib/config.ts (CLAUDE.md rule 1).
# Leave unset to inherit the general/mini defaults.
OPENAI_MODEL_GENERAL=
OPENAI_MODEL=
OPENAI_MODEL_WIN_DRAFT=
OPENAI_MODEL_WIN_STRUCTURE=
OPENAI_MODEL_DIGEST_COMPOSE=
OPENAI_MODEL_MONTH_REVIEW=
OPENAI_MODEL_PACKET_THEMES=
OPENAI_MODEL_PACKET_MAP=
OPENAI_MODEL_PACKET_COMPOSE=
OPENAI_MODEL_INTERVIEW_TURN=
OPENAI_MODEL_INTERVIEW_EXTRACT=
OPENAI_MODEL_RADAR_NORMALIZE=
OPENAI_MODEL_RADAR_REASON=

# ---------------------------------------------------------------------------
# Auth (Clerk)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated Clerk user ids with access to /admin.
ADMIN_USER_IDS=

# ---------------------------------------------------------------------------
# Background jobs (impl/00 ADR-1, ADR-2)
# ---------------------------------------------------------------------------
# Required. The cron endpoint FAILS CLOSED when unset — an open tick endpoint
# is a queue-DoS surface.
CRON_SECRET=
JOB_BATCH_SIZE=25
# Must sit under the platform function timeout: 45000 on Vercel Hobby (60s cap),
# up to 240000 on Pro (300s).
CRON_TIME_BUDGET_MS=45000
# Required in production. Without it the self-retrigger falls back to a
# deployment-specific origin and the drain chain silently does not fire.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email (impl/00 ADR-4)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Must be on the verified SENDING SUBDOMAIN, never the root domain.
EMAIL_FROM=Patronus <hello@mail.example.com>
EMAIL_REPLY_TO=
# Required, or /api/email/webhook returns 503 and accepts nothing — an
# unverified webhook could suppress any user whose provider id is guessable.
RESEND_WEBHOOK_SECRET=
EMAIL_UNSUBSCRIBE_MAILTO=

# ---------------------------------------------------------------------------
# Signed action tokens
# ---------------------------------------------------------------------------
# Signs the one-tap confirm links in the weekly digest. Single-use, 30-day
# expiry, scoped to one (win, action) pair.
WIN_MAGIC_LINK_SECRET=

# ---------------------------------------------------------------------------
# Billing (Stripe)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Display names live in src/lib/plans.ts; Tier.always_on renders as "Career"
# and Tier.pro as "Search" (CLAUDE.md rule 4).
STRIPE_PRICE_CAREER_ANNUAL=
STRIPE_PRICE_CAREER_MONTHLY=
STRIPE_PRICE_SEARCH_MONTHLY=

# ---------------------------------------------------------------------------
# Entitlements
# ---------------------------------------------------------------------------
# Defaults to enforcing in production only. Keep false until the monetization
# launch so real usage accrues before anyone is turned away.
ENTITLEMENTS_ENFORCE=false
ENTITLEMENT_FREE_TAILORED_PER_MONTH=3
ENTITLEMENT_ALWAYS_ON_TAILORED_PER_MONTH=15
USAGE_MAX_MONTHLY_TOKENS_PER_USER=300000
USAGE_MAX_MONTHLY_COST_USD_PER_USER=10

# ---------------------------------------------------------------------------
# Integrations
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Storage / rate limiting
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
