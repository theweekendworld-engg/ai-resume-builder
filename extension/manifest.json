{
  "manifest_version": 3,
  "name": "Patronus Job Copilot",
  "description": "Developer job application copilot for analysis, autofill, and resume tailoring.",
  "version": "0.0.1",
  "permissions": ["storage", "tabs", "sidePanel", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Patronus Job Copilot",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "parsers/utils.js",
        "parsers/page-classifier.js",
        "parsers/dom-reducer.js",
        "parsers/jd-extractor.js",
        "parsers/field-detector.js",
        "parsers/index.js",
        "fill/fill-executor.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
